#!/bin/sh
# pre-push: run the same gate CI runs, before anything leaves your machine.
#
# Why this exists: it shortens the feedback loop. You find out that the build
# is red in seconds, locally, instead of minutes later in a CI log.
#
# It is NOT the enforcement boundary. `main` is protected server-side by the
# `main-requires-verify` ruleset, which requires two status checks — `verify`
# (CI) and `review-attested` (a human read the diff) — and has no bypass
# actors. That is the control that actually holds.
#
# This hook is the weaker, local half, and it is important to know why:
#   - it runs on your machine, so it is only as trustworthy as your machine
#   - `git push --no-verify` skips it entirely
#   - it does not apply to anyone else, or to the GitHub web UI
#
# It is still worth having: it catches the realistic failure — you, in a
# hurry, pushing something that does not build — without pretending to be
# an enforcement boundary.
#
# Enable with: npm run setup-hooks   (sets core.hooksPath to .githooks)

set -e

echo "pre-push: running npm run verify (the same gate CI runs)..."

if ! npm run verify; then
  echo ""
  echo "pre-push: verify FAILED — push aborted."
  echo ""
  echo "  Fix it, or bypass deliberately with:  git push --no-verify"
  echo ""
  exit 1
fi

echo "pre-push: verify passed."
